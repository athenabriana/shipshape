#!/usr/bin/env python3
"""
A stand-in for `gh` in the companion's behavior harness: it answers from the scenario's
fixture world (COMPANION_FIXTURE) and records every call (COMPANION_CALLS), so nothing
reaches GitHub and nothing merges.

Part of the companion plugin, Apache License, Version 2.0 (see LICENSE and NOTICE).
"""

import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["COMPANION_CALLS"], "a", encoding="utf-8") as log:
    log.write(json.dumps({"t": "gh", "args": args}) + "\n")
with open(os.environ["COMPANION_FIXTURE"], encoding="utf-8") as f:
    world = json.load(f)


def flag(name, default=None):
    for i, a in enumerate(args):
        if a == name and i + 1 < len(args):
            return args[i + 1]
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return default


positional = [a for i, a in enumerate(args) if not a.startswith("-") and (i == 0 or args[i - 1] not in ("--repo", "-R", "--json", "--jq", "-q", "--author", "--state", "-L", "--limit"))]
repo = flag("--repo") or flag("-R") or world.get("default_repo", "athenabriana/shipshape")
group, sub = (positional + ["", ""])[:2]
number = next((p for p in positional[2:] if p.isdigit()), None)
key = f"{repo}#{number}"

if group == "pr" and sub == "merge":
    print(f"✓ Squashed and merged pull request {key}")
elif group == "pr" and sub == "view" and key in world.get("prs", {}):
    print(json.dumps(world["prs"][key], ensure_ascii=False))
elif group == "pr" and sub == "checks" and key in world.get("checks", {}):
    print(world["checks"][key])
elif (group == "pr" and sub in ("list", "status")) or (group == "search" and sub == "prs"):
    print(json.dumps(world.get("search", []), ensure_ascii=False))
elif group == "run":
    print(world.get("runs", ""))
elif group == "api":
    print(json.dumps(world.get("api", {}), ensure_ascii=False))
else:
    print(f"fixture gh: nothing for {' '.join(args)}", file=sys.stderr)
    sys.exit(1)
